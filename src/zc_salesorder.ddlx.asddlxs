@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Sales Order',
    typeNamePlural: 'Sales Orders',
    title:       { type: #STANDARD, value: 'Vbeln' },
    description: { type: #STANDARD, value: 'Ernam' }
  }
}
@EndUserText.label: 'Salesorder - Metadata Extension'
annotate entity ZC_SalesOrder with
{
  @UI.facets: [
    {
      $Type:  'UI.ReferenceFacet',
      id:     'Details',
      label:  'Sales Order Details',
      Target: '@UI.FieldGroup#Details'
    }
  ]

  @UI.lineItem:       [{ position: 10, importance: #HIGH,   label: 'Sales Document' }]
  @UI.selectionField: [{ position: 10 }]
  @UI.fieldGroup #Details: [{ position: 10, label: 'Sales Document' }]
  Vbeln;

  @UI.lineItem:       [{ position: 20, importance: #HIGH,   label: 'Creation Date' }]
  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup #Details: [{ position: 20, label: 'Creation Date' }]
  Erdat;

  @UI.lineItem:       [{ position: 30, importance: #MEDIUM, label: 'Created By' }]
  @UI.selectionField: [{ position: 30 }]
  @UI.fieldGroup #Details: [{ position: 30, label: 'Created By' }]
  Ernam;

  @UI.lineItem:       [{ position: 40, importance: #MEDIUM, label: 'Document Category' }]
  @UI.selectionField: [{ position: 40 }]
  @UI.fieldGroup #Details: [{ position: 40, label: 'Document Category' }]
  Vbtyp;

  @UI.lineItem:       [{ position: 50, importance: #HIGH,   label: 'Sales Organization' }]
  @UI.selectionField: [{ position: 50 }]
  @UI.fieldGroup #Details: [{ position: 50, label: 'Sales Organization' }]
  Vkorg;
}