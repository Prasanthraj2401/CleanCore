managed implementation in class zbp_i_vbak unique;
strict(2);

define behavior for ZI_VBAK alias VBAK
authorization master ( instance )
persistent table vbak
lock master
{
  create;
  update;
  delete;

  validation validateMandatoryFields on save { create; update; }

  field ( readonly : update ) Vbeln;
  field ( mandatory : create ) Vbeln;
}

define behavior for ZC_VBAK alias VBAKP
{
  use create;
  use update;
  use delete;
}